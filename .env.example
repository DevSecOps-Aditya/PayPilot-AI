# Local development generates a stable key in instance/secret_key automatically.
# For a hosted deployment, set PAYPILOT_ENV=production and provide a strong key.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
GEMINI_API_KEY=
# Model ID is configurable because Google renames/retires models; check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Local development callback. On Render, omit this variable to use RENDER_EXTERNAL_URL.
PAYPAL_RETURN_BASE_URL=http://127.0.0.1:5000
